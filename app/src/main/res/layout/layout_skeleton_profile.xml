<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/chk_surfaceColor"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/chk_dividerHorizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:alpha="0.15"
                android:background="@drawable/circle_shape"
                android:backgroundTint="?attr/chk_textColorHint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="140dp"
                    android:layout_height="18dp"
                    android:alpha="0.2"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="90dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:alpha="0.2"
                android:background="@drawable/bg_rounded_square_soft"
                android:backgroundTint="?attr/chk_textColorHint" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?attr/chk_dividerHorizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.2"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="90dp"
                        android:layout_height="10dp"
                        android:layout_marginBottom="8dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="140dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="4dp"
                        android:alpha="0.2"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.2"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="10dp"
                        android:layout_marginBottom="8dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="160dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="4dp"
                        android:alpha="0.2"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>