<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chk_backgroundColor"
    android:fitsSystemWindows="true"
    tools:context=".HomePage">

    <!-- Sticky Action Buttons (shown on scroll) -->
    <FrameLayout
        android:id="@+id/stickyActionButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="?attr/chk_backgroundColor"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:visibility="gone">
        <include
            android:id="@+id/stickyButtons"
            layout="@layout/layout_home_action_buttons" />
    </FrameLayout>

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/bottomNavCard"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <!-- Skeleton Loader (global) -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/skeletonLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavCard"
        android:visibility="gone">

        <include layout="@layout/layout_skeleton_home" />
    </com.facebook.shimmer.ShimmerFrameLayout>


    <!-- ═══════════════════════════════════════════════════════════════
         MAIN SCROLLABLE CONTENT
         ═══════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavCard"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp">

            <!-- Shimmer Skeleton (inside scroll) -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/homeShimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shimmer_auto_start="true"
                android:visibility="visible"
                tools:visibility="gone">

                <include
                    android:id="@+id/homeSkeletonLayout"
                    layout="@layout/layout_skeleton_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- ═══════════════════════════════════════════════════════
                 REAL CONTENT (shown after loading)
                 ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/homeContentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- ─────────────────────────────────────────────────
                     SECTION 1: Current Cashbook Header
                     ───────────────────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/userBoxCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/chk_headerColor"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/userBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <!-- Icon with tinted background chip -->
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="14dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_icon_chip" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_book"
                                app:tint="?attr/chk_balanceColor" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/userNameTop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_font"
                                android:text="Current Book"
                                android:textColor="?attr/chk_textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/lastOpenedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/app_font"
                                android:text="Last opened: Just now"
                                android:textColor="?attr/chk_textColorHint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Chevron arrow for visual affordance -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/chk_textColorHint"
                            android:contentDescription="Switch cashbook" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hidden cashbook name holder (used by ViewModel) -->
                <TextView
                    android:id="@+id/currentCashbookText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- ─────────────────────────────────────────────────
                     SECTION 2: Balance Card (Flippable)
                     ───────────────────────────────────────────────── -->
                <include
                    android:id="@+id/balanceCardView"
                    layout="@layout/component_balance_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <!-- ─────────────────────────────────────────────────
                     SECTION 3: Cash In / Cash Out Buttons
                     ───────────────────────────────────────────────── -->
                <include
                    android:id="@+id/originalButtons"
                    layout="@layout/layout_home_action_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <!-- ─────────────────────────────────────────────────
                     SECTION 4: Daily Summary Header
                     ───────────────────────────────────────────────── -->
                <include
                    android:id="@+id/dailySummaryInclude"
                    layout="@layout/layout_daily_summary_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp" />

                <!-- ─────────────────────────────────────────────────
                     SECTION 5: Today's Transactions Card
                     ───────────────────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/transactionListCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/transaction_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Transaction Table Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"

                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/transactionCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:fontFamily="@font/app_font"
                                android:gravity="start"
                                android:text="Today's Transactions"
                                android:textColor="?attr/chk_balanceColor"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/app_font"
                                android:gravity="center"
                                android:text="MODE"
                                android:textColor="?attr/chk_textColorHint"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/app_font"
                                android:gravity="center"
                                android:text="IN"
                                android:textColor="?attr/chk_incomeColor"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/app_font"
                                android:gravity="center"
                                android:text="OUT"
                                android:textColor="?attr/chk_expenseColor"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/chk_dividerHorizontal" />

                        <!-- Transaction Rows Container -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TableLayout
                                android:id="@+id/transactionTable"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="4dp"
                                android:stretchColumns="*">
                            </TableLayout>

                            <!-- Empty State -->
                            <LinearLayout
                                android:id="@+id/emptyStateView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:visibility="gone"
                                android:paddingHorizontal="24dp"
                                android:paddingTop="32dp"
                                android:paddingBottom="28dp">

                                <ImageView
                                    android:layout_width="88dp"
                                    android:layout_height="88dp"
                                    android:src="@drawable/ic_empty_state"
                                    android:layout_marginBottom="16dp"
                                    app:tint="?attr/chk_textColorHint"
                                    android:alpha="0.6" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="No entries for today"
                                    android:fontFamily="@font/app_font"
                                    android:textColor="?attr/chk_textColorPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Start tracking by adding your first entry"
                                    android:fontFamily="@font/app_font"
                                    android:textColor="?attr/chk_textColorHint"
                                    android:textSize="13sp" />

                                <!-- Helpful Tip Banner -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:background="@drawable/bg_rounded_square_soft"
                                    android:padding="16dp"
                                    android:layout_marginTop="24dp"
                                    android:gravity="center_vertical">

                                    <FrameLayout
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginEnd="12dp">

                                        <View
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@drawable/bg_icon_chip" />

                                        <ImageView
                                            android:layout_width="18dp"
                                            android:layout_height="18dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_info"
                                            app:tint="?attr/chk_balanceColor" />
                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Tap 'Cash In' or 'Cash Out' above to add your first transaction for today."
                                        android:fontFamily="@font/app_font"
                                        android:textColor="?attr/chk_textColorSecondary"
                                        android:textSize="13sp"
                                        android:lineSpacingExtra="3dp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>