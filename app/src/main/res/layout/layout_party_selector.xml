<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/partySelectorLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:paddingBottom="6dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/partyInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Party (Optional)"
        android:textColorHint="?attr/chk_textColorSecondary"
        app:hintTextColor="?attr/chk_primary_blue"
        app:boxStrokeColor="?attr/chk_primary_blue"
        app:boxStrokeWidth="1dp"
        app:boxBackgroundColor="?attr/chk_surfaceColor"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/partyTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="52dp"
            android:inputType="textPersonName"
            android:focusable="true"
            android:clickable="true"
            android:textColor="?attr/chk_textColorPrimary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:id="@+id/contactBookButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_search_field"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_contacts"
            app:tint="?attr/chk_primary_blue"
            android:contentDescription="Select Contact"/>
    </FrameLayout>

</RelativeLayout>