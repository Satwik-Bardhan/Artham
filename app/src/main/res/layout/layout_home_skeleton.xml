<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/chk_headerColor"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:alpha="0.2"
                android:background="@drawable/circle_shape"
                android:backgroundTint="?attr/chk_textColorHint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="148dp"
                    android:layout_height="18dp"
                    android:alpha="0.2"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="90dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    android:alpha="0.2"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="?attr/chk_surfaceColor"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/skelUidSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:alpha="0.1"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:alpha="0.15"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/skelBalanceSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/skelUidSection"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <View
                    android:layout_width="180dp"
                    android:layout_height="36dp"
                    android:alpha="0.2"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/skelInOutSection"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_below="@id/skelBalanceSection"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="12dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp"
                        android:alpha="0.2"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="40dp"
                    android:alpha="0.1"
                    android:background="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="12dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp"
                        android:alpha="0.2"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/skelUserName"
                android:layout_width="100dp"
                android:layout_height="12dp"
                android:layout_below="@id/skelInOutSection"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:alpha="0.1"
                android:background="@drawable/bg_rounded_tag"
                android:backgroundTint="?attr/chk_textColorHint" />

            <View
                android:layout_width="50dp"
                android:layout_height="10dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:alpha="0.1"
                android:background="@drawable/bg_rounded_tag"
                android:backgroundTint="?attr/chk_textColorHint" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"

        android:weightSum="2">

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_square_soft"
            android:backgroundTint="?attr/chk_surfaceColor" />

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_square_soft"
            android:backgroundTint="?attr/chk_surfaceColor" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="?attr/chk_surfaceColor"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/chk_dividerHorizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.3"
                    android:background="@drawable/bg_rounded_square_soft"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="14dp"
                        android:alpha="0.2"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="?attr/chk_dividerHorizontal"
                android:layout_marginHorizontal="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.3"
                    android:background="@drawable/bg_rounded_square_soft"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <View
                        android:layout_width="70dp"
                        android:layout_height="14dp"
                        android:alpha="0.2"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/chk_surfaceColor"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="2"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:alpha="0.2"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="36dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/chk_dividerHorizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.15"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="14dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/chk_dividerHorizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.15"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="14dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>