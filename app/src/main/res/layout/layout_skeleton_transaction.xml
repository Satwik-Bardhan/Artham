                                    android:layout_height="16dp"
                                    android:layout_marginEnd="16dp"
                                    android:layout_weight="1"
                                    android:alpha="0.2"
                                    android:background="@drawable/bg_rounded_tag"
                                    android:backgroundTint="?attr/chk_textColorHint" />

                                <View
