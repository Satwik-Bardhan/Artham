<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chk_backgroundColor"
    android:fitsSystemWindows="true">

    <!-- Header Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/chk_headerColor"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/chk_dividerHorizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_arrow_left"
                app:tint="?attr/chk_textColorPrimary"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/backButton"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:text="Select Category"
                android:fontFamily="@font/app_font"
                android:textColor="?attr/chk_textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Optional: Search Icon in Header -->
            <ImageView
                android:id="@+id/searchButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                app:tint="?attr/chk_textColorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Search"
                android:visibility="visible"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCard"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp"> <!-- Padding for FAB -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- "No Category" Option -->
            <LinearLayout
                android:id="@+id/noCategoryClickable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_input_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <RadioButton
                    android:id="@+id/radioNoCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="?attr/chk_primary_blue"
                    android:clickable="false"
                    android:focusable="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/app_font"
                    android:text="No Category"
                    android:textColor="?attr/chk_textColorPrimary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/app_font"
                android:text="Quick Suggestions"
                android:textColor="?attr/chk_textColorSecondary"
                android:textStyle="bold" />

            <!-- Quick Suggestions Grid: Food, Shopping, Transport -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/quickCategoryFood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_input_background"
                    android:fontFamily="@font/app_font"
                    android:text="Food"
                    android:textAllCaps="false"
                    android:textColor="?attr/chk_textColorPrimary"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_food_dining"
                    android:drawableTint="#FF5722"/>

                <Button
                    android:id="@+id/quickCategoryShopping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_input_background"
                    android:fontFamily="@font/app_font"
                    android:text="Shopping"
                    android:textAllCaps="false"
                    android:textColor="?attr/chk_textColorPrimary"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_receipt"
                    android:drawableTint="#E91E63"/>

                <Button
                    android:id="@+id/quickCategoryTransport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_input_background"
                    android:fontFamily="@font/app_font"
                    android:text="Transport"
                    android:textAllCaps="false"
                    android:textColor="?attr/chk_textColorPrimary"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_transportation"
                    android:drawableTint="#3F51B5"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/categoryLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All Categories"
                    android:fontFamily="@font/app_font"
                    android:textColor="?attr/chk_textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/categoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/app_font"
                    android:text="5 default items"
                    android:textSize="14sp"
                    android:textColor="?attr/chk_textColorSecondary" />
            </LinearLayout>

            <!-- DEMO CATEGORY ITEMS (Arranged in 2 Columns) -->

            <!-- Row 1: Rent & Bills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="8dp">

                <!-- Rent -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/rounded_input_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_shape">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_home"
                            app:tint="#009688"
                            android:contentDescription="Rent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Rent"
                        android:fontFamily="@font/app_font"
                        android:textColor="?attr/chk_textColorPrimary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/chk_textColorSecondary"/>
                </LinearLayout>

                <!-- Bills & Utilities -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/rounded_input_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="4dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_shape">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_utilities"
                            app:tint="#FFC107"
                            android:contentDescription="Utilities" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Bills"
                        android:fontFamily="@font/app_font"
                        android:textColor="?attr/chk_textColorPrimary"
                        android:textSize="15sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/chk_textColorSecondary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Entertainment & Medical -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="8dp">

                <!-- Entertainment -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/rounded_input_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_shape">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_entertainment"
                            app:tint="#9C27B0"
                            android:contentDescription="Entertainment" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Fun"
                        android:fontFamily="@font/app_font"
                        android:textColor="?attr/chk_textColorPrimary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/chk_textColorSecondary"/>
                </LinearLayout>

                <!-- Medical -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/rounded_input_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="4dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_shape">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_medicine"
                            app:tint="#F44336"
                            android:contentDescription="Medical" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Medical"
                        android:fontFamily="@font/app_font"
                        android:textColor="?attr/chk_textColorPrimary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/chk_textColorSecondary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Salary & Empty -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Salary -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/rounded_input_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_shape">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_money"
                            app:tint="#4CAF50"
                            android:contentDescription="Salary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Salary"
                        android:fontFamily="@font/app_font"
                        android:textColor="?attr/chk_textColorPrimary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/chk_textColorSecondary"/>
                </LinearLayout>

                <!-- Invisible Spacer to keep alignment -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!--
                 RecyclerView handles the dynamic list.
                 In code, ensure GridLayoutManager with spanCount = 2 is used.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoriesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button for Creating New Categories -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addNewCategoryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:fontFamily="@font/app_font"
        android:text="Create New"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:backgroundTint="?attr/chk_primary_blue"
        app:icon="@drawable/ic_add"
        app:iconTint="@android:color/white"
        android:elevation="6dp"/>

</RelativeLayout>