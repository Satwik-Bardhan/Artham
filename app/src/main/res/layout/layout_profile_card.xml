<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/chk_surfaceColor"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/profileSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════════
             BANNER — Colored top area with avatar
             ══════════════════════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cash_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="46dp">

            <!-- User Name — large, top-left -->
            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/editButton"
                android:layout_marginEnd="12dp"
                tools:text="Artham User"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Edit button — top-right, square style -->
            <FrameLayout
                android:id="@+id/editButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    app:tint="@android:color/white"
                    android:contentDescription="Edit Profile" />
            </FrameLayout>

        </RelativeLayout>

        <!-- ══════════════════════════════════════════
             AVATAR — Overlapping banner and info
             ══════════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-36dp"
            android:paddingStart="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImg"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="?attr/chk_surfaceColor"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder"
                app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />
        </FrameLayout>

        <!-- ══════════════════════════════════════════
             INFO SECTION — Below the banner
             ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <!-- UID and Copy Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/uidText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="UID: SWWD6ZP6XXXXXXXXXX"
                    android:textColor="?attr/chk_textColorSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/copyUidButton"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_copy"
                    app:tint="?attr/chk_textColorSecondary"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp"
                    android:contentDescription="Copy UID" />
            </LinearLayout>

            <!-- Created Date (below UID) -->
            <TextView
                android:id="@+id/createdDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Joined Jan 2024"
                android:textColor="?attr/chk_textColorSecondary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.03" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="?attr/chk_dividerHorizontal" />

            <!-- Active Cashbook (full width, cloud section removed) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_book"
                        app:tint="?attr/chk_primary_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE CASHBOOK"
                        android:textColor="?attr/chk_textColorHint"
                        android:textSize="10sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/activeCashbookName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="My Wallet"
                    android:textColor="?attr/chk_textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>