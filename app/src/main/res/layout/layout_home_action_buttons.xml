<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/action_btn_container_padding_h"
    android:paddingVertical="6dp">

    <!-- CASH IN BUTTON -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/action_btn_gap"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/chk_incomeColor"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/btnCashIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="@dimen/action_btn_padding_start"
            android:paddingVertical="@dimen/action_btn_padding_v">

            <!-- Text Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CASH IN"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/action_btn_title_size"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add income"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/action_btn_subtitle_size"
                    android:layout_gravity="center"
                    android:layout_marginTop="1dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- CASH OUT BUTTON -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/action_btn_gap"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/chk_expenseColor"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/btnCashOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="@dimen/action_btn_padding_start"
            android:paddingVertical="@dimen/action_btn_padding_v">


            <!-- Text Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CASH OUT"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/action_btn_title_size"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add expense"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/action_btn_subtitle_size"
                    android:layout_gravity="center"
                    android:layout_marginTop="1dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>