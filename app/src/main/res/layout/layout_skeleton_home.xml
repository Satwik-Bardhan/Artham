<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="24dp">

    <!-- Section 1: User Box Card (MaterialCardView, 16dp corner, 1dp stroke) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/chk_headerColor"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/chk_dividerHorizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- Icon chip -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.15"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="148dp"
                    android:layout_height="17dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="170dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0.1"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>

            <!-- Chevron placeholder -->
            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:alpha="0.1"
                android:background="@drawable/circle_shape"
                android:backgroundTint="?attr/chk_textColorHint" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section 2: Balance Card (230dp, 16dp corner, 3dp elev) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/chk_surfaceColor"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/skelUidSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:alpha="0.1"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:alpha="0.15"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/skelBalanceSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/skelUidSection"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="60dp"
                    android:layout_height="10dp"
                    android:alpha="0.1"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/skelInOutSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/skelBalanceSection"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:alpha="0.1"
                    android:background="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/skelUserName"
                android:layout_width="100dp"
                android:layout_height="11dp"
                android:layout_below="@id/skelInOutSection"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:alpha="0.1"
                android:background="@drawable/bg_rounded_tag"
                android:backgroundTint="?attr/chk_textColorHint" />

            <View
                android:layout_width="50dp"
                android:layout_height="10dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:alpha="0.1"
                android:background="@drawable/bg_rounded_tag"
                android:backgroundTint="?attr/chk_textColorHint" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section 3: Action Buttons (14dp corner, 3dp elev, 56dp height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="10dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.1"
                android:background="@drawable/bg_rounded_square_soft"
                android:backgroundTint="?attr/chk_textColorHint" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:alpha="0.1"
                android:background="@drawable/bg_rounded_square_soft"
                android:backgroundTint="?attr/chk_textColorHint" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Section 4: Daily Summary (16dp corner, 1dp stroke) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/chk_surfaceColor"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/chk_dividerHorizontal"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.1"
                    android:background="@drawable/bg_icon_chip" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="14dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:alpha="0.1"
                android:background="?attr/chk_textColorHint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.1"
                    android:background="@drawable/bg_icon_chip" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="70dp"
                        android:layout_height="14dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />

                    <View
                        android:layout_width="60dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Section 5: Transaction Table Card (16dp corner, 1dp stroke) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/chk_surfaceColor"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/chk_dividerHorizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="2"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="36dp"
                        android:layout_height="10dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.1"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.1"
                android:background="?attr/chk_textColorHint" />

            <!-- Transaction row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="2"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="36dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.1"
                android:background="?attr/chk_textColorHint" />

            <!-- Transaction row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="2"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="36dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.1"
                android:background="?attr/chk_textColorHint" />

            <!-- Transaction row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="2"
                    android:alpha="0.15"
                    android:background="@drawable/bg_rounded_tag"
                    android:backgroundTint="?attr/chk_textColorHint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="36dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="10dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_rounded_tag"
                        android:backgroundTint="?attr/chk_textColorHint" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>