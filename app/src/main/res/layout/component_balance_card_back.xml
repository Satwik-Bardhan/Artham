<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/balanceCardBack"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="@drawable/cash_card"
        android:padding="20dp">

        <!-- Profile Section -->
        <LinearLayout
            android:id="@+id/profileSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/backProfileImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder"
                android:background="#22FFFFFF"
                app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/backUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Artham Member"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:letterSpacing="0.04"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_below="@id/profileSection"
            android:layout_marginBottom="18dp"/>

        <!-- Social Media Links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_below="@id/divider"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnInstagram"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/instagram"
                android:contentDescription="Instagram"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:layout_marginEnd="24dp"/>

            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/facebook"
                android:contentDescription="Facebook"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:layout_marginEnd="24dp"/>

            <ImageView
                android:id="@+id/btnYoutube"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/youtube"
                android:contentDescription="YouTube"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:layout_marginEnd="24dp"/>

            <ImageView
                android:id="@+id/btnWhatsapp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/whatsapp"
                android:contentDescription="WhatsApp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:layout_marginEnd="24dp"/>

            <ImageView
                android:id="@+id/btnGmail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/gmail"
                android:contentDescription="Gmail"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Bottom Left: Made in India -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:text="Made in india 🇮🇳 with ❤️"
            android:textColor="#777777"
            android:textSize="10sp"
            android:letterSpacing="0.02"/>

        <!-- Bottom Right: Tap to flip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:text="Tap to flip"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="italic" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>