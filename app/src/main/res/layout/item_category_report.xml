<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/circle_shape">

        <ImageView
            android:id="@+id/categoryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_category"
            android:contentDescription="Category Icon" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/categoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Category Name"
            android:fontFamily="@font/app_font"
            android:textColor="?attr/chk_textColorPrimary"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"/>

        <ProgressBar
            android:id="@+id/categoryProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            tools:progress="45"
            android:progressBackgroundTint="?attr/chk_dividerHorizontal" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/categoryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="₹0.00"
            android:fontFamily="@font/app_font"
            android:textColor="?attr/chk_textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/categoryPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="0%"
            android:fontFamily="@font/app_font"
            android:textColor="?attr/chk_textColorSecondary"
            android:textSize="12sp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/chevronRight"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/chk_textColorHint"
        android:contentDescription="View details" />

</LinearLayout>