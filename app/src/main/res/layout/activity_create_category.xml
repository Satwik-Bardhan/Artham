<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chk_backgroundColor"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/chk_textColorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Go Back"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Category"
            android:fontFamily="@font/app_font"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/chk_textColorPrimary"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category Name"
        app:boxStrokeColor="?attr/chk_primary_blue"
        app:hintTextColor="?attr/chk_primary_blue"
        android:textColorHint="?attr/chk_textColorHint"
        app:boxBackgroundColor="?attr/chk_surfaceColor"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/categoryNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="?attr/chk_textColorPrimary"
            android:fontFamily="@font/app_font"/>

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Icon"
        android:fontFamily="@font/app_font"
        android:textColor="?attr/chk_textColorSecondary"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iconsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:layout_height="60dp"/> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Choose Color"
    android:fontFamily="@font/app_font"
    android:textColor="?attr/chk_textColorSecondary"
    android:layout_marginTop="24dp"
    android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/colorsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:layout_height="60dp"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Create Category"
        android:fontFamily="@font/app_font"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/button_primary"
        app:backgroundTint="?attr/chk_primary_blue"/>

</LinearLayout>