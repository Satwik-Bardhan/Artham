<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/balanceCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:id="@+id/balanceCard"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="@drawable/cash_card"
        android:padding="20dp">

        <!-- UID Section — Frosted Glass Pill -->
        <LinearLayout
            android:id="@+id/uidSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/uid_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_alignParentTop="true">

            <TextView
                android:id="@+id/uidText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="UID User Unique Id"
                android:textColor="#BBBBBB"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:ellipsize="end"
                android:maxLines="1"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/copyUidButton"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Copy UID"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/ic_copy"
                app:tint="#BBBBBB" />
        </LinearLayout>

        <!-- Balance Section — Hero Display -->
        <LinearLayout
            android:id="@+id/balanceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/uidSection"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BALANCE"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/balanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="Current balance amount"
                android:gravity="center"
                android:maxLines="2"
                android:text="₹0.00"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- In/Out Section — Split Display -->
        <LinearLayout
            android:id="@+id/inOutSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/balanceSection"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL IN"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/moneyIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Total money in"
                    android:text="₹0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL OUT"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/moneyOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Total money out"
                    android:text="₹0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tap to Flip hint (Bottom Right) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:text="Tap to flip"
            android:textColor="#666666"
            android:textSize="10sp"
            android:textStyle="italic"
            tools:ignore="HardcodedText" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>