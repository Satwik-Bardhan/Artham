<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="4dp"
    android:layout_marginStart="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/chk_dividerHorizontal"
    app:cardBackgroundColor="?attr/chk_surfaceColor"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="100dp"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/monthNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="JANUARY"
            android:textSize="14sp"
            android:fontFamily="@font/app_font"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp"
            android:textColor="?attr/chk_textColorPrimary"/>

        <!-- Added ID 'yearContainer' here to reference it in Java -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/yearContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="?attr/chk_dividerHorizontal"
            app:strokeWidth="1dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/yearTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2025"
                android:textSize="11sp"
                android:fontFamily="@font/app_font"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="?attr/chk_textColorSecondary"/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>